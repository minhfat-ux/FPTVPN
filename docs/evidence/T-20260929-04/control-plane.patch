+// ---- mã máy (bus #591 / T-20260929-04) -----------------------------------------------------------
+// Cài lại app Android: cùng MÃ MÁY nhưng khoá mới ⇒ phải nhường slot bản ghi cũ, nếu không khách bị
+// coi là "thiết bị mới" (đầy hạn mức) và dashboard lại đếm thừa.
+
+const OLD_ANDROID = {
+  id: "dev-old-android",
+  userId: "user-1",
+  platform: "android",
+  publicKey: "OLDANDROID=",
+  deviceName: "android-3efd5cae",
+  active: true,
+  machineId: "ANDROID-ABC",
+};
+
+test("khai machine_id trùng bản ghi cũ ⇒ thu hồi bản ghi cũ để nhường slot", async () => {
+  const store = makeStore([OLD_ANDROID]);
+  const removedKeys = [];
+  const res = await applyDeviceReplace({
+    body: { machine_id: "ANDROID-ABC" },
+    userId: "user-1",
+    platform: "android",
+    publicKey: "NEWANDROID=",
+    machineId: "ANDROID-ABC",
+    store,
+    removePeer: async (device) => { removedKeys.push(device.publicKey); },
+    log: { log() {} },
+  });
+  assert.deepEqual(res.replaced, { device_id: "dev-old-android", name: "android-3efd5cae" });
+  assert.deepEqual(removedKeys, ["OLDANDROID="]);
+  assert.deepEqual(store.state.deactivated, ["dev-old-android"]);
+});
+
+test("machine_id lạ thì KHÔNG đụng ai (không có bản ghi cùng mã máy)", async () => {
+  const store = makeStore([OLD_ANDROID]);
+  const res = await applyDeviceReplace({
+    body: { machine_id: "ANDROID-OTHER" },
+    userId: "user-1",
+    platform: "android",
+    publicKey: "NEWANDROID=",
+    machineId: "ANDROID-OTHER",
+    store,
+    removePeer: async () => { throw new Error("không được gọi tới đây"); },
+    log: { log() {} },
+  });
+  assert.equal(res.replaced, null);
+  assert.deepEqual(store.state.deactivated, []);
+});
+
+test("machine_id của tài khoản KHÁC thì không được cướp slot", async () => {
+  const store = makeStore([OLD_ANDROID]);
+  const res = await applyDeviceReplace({
+    body: { machine_id: "ANDROID-ABC" },
+    userId: "user-2",
+    platform: "android",
+    publicKey: "NEWANDROID=",
+    machineId: "ANDROID-ABC",
+    store,
+    removePeer: async () => { throw new Error("không được gọi tới đây"); },
+    log: { log() {} },
+  });
+  assert.equal(res.replaced, null);
+  assert.deepEqual(store.state.deactivated, []);
+});
