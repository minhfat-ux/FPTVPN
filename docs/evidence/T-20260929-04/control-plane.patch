diff --git a/control-plane/test/device-machines.test.js b/control-plane/test/device-machines.test.js
new file mode 100644
index 0000000..0782326
--- /dev/null
+++ b/control-plane/test/device-machines.test.js
@@ -0,0 +1,88 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { machineKey, normalizeMachineId, summarizeMachines } from "../src/device-machines.js";
+
+/**
+ * Vì sao nhóm test này quan trọng: đây là con số chủ dự án nhìn trên Dashboard. Đếm sai một lần nữa
+ * (bus #591) là lại phải giải thích. Bộ dữ liệu dưới đây lấy ĐÚNG số đo thật trên node-2 lúc
+ * 23:10 ngày 29/09/2026.
+ */
+
+test("normalizeMachineId: rỗng/không phải chuỗi ⇒ null; cắt tối đa 128 ký tự", () => {
+  assert.equal(normalizeMachineId(undefined), null);
+  assert.equal(normalizeMachineId(""), null);
+  assert.equal(normalizeMachineId("   "), null);
+  assert.equal(normalizeMachineId("  abc  "), "abc");
+  assert.equal(normalizeMachineId("x".repeat(200)).length, 128);
+});
+
+test("mã máy: hai bản ghi cùng (user, platform, machineId) là MỘT máy", () => {
+  const a = { id: "rec-1", userId: "u1", platform: "android", machineId: "ANDROID-ABC" };
+  const b = { id: "rec-2", userId: "u1", platform: "android", machineId: "ANDROID-ABC" };
+  assert.equal(machineKey(a), machineKey(b));
+  assert.equal(summarizeMachines([a, b]).machines, 1);
+  assert.equal(summarizeMachines([a, b]).records, 2);
+});
+
+test("cùng mã máy nhưng KHÁC tài khoản ⇒ hai máy (không gộp người khác vào nhau)", () => {
+  const a = { id: "rec-1", userId: "u1", platform: "android", machineId: "ANDROID-ABC" };
+  const b = { id: "rec-2", userId: "u2", platform: "android", machineId: "ANDROID-ABC" };
+  assert.notEqual(machineKey(a), machineKey(b));
+  assert.equal(summarizeMachines([a, b]).machines, 2);
+});
+
+test("Android CŨ không có mã máy: gộp theo tài khoản và đếm là 1 (không thể phân biệt)", () => {
+  const legacy = [1, 2, 3, 4, 5].map((n) => ({
+    id: `rec-${n}`,
+    userId: "u1",
+    platform: "android",
+    machineId: null,
+    deviceName: `android-${n}`,
+  }));
+  const s = summarizeMachines(legacy);
+  assert.equal(s.machines, 1, "5 bản ghi cài lại của cùng một máy ⇒ 1 máy");
+  assert.equal(s.records, 5);
+  assert.equal(s.legacy_android_records, 5);
+  assert.equal(s.legacy_android_grouped_away, 4);
+});
+
+test("iOS/macOS/Windows giữ danh tính qua cài lại ⇒ mỗi bản ghi là một máy", () => {
+  const devices = [
+    { id: "r1", userId: "u1", platform: "ios", machineId: null },
+    { id: "r2", userId: "u1", platform: "macos", machineId: null },
+    { id: "r3", userId: "u1", platform: "windows", machineId: null },
+  ];
+  const s = summarizeMachines(devices);
+  assert.equal(s.machines, 3);
+  assert.equal(s.legacy_android_records, 0);
+  assert.equal(s.legacy_android_grouped_away, 0);
+});
+
+test("SỐ ĐO THẬT 29/09/2026: 10 bản ghi ⇒ 6 máy", () => {
+  const devices = [
+    { id: "7fef3dfe", userId: "d5ffd512", platform: "ios" },
+    { id: "d89c4f6c", userId: "4230df97", platform: "macos" },
+    { id: "cae3e5b2", userId: "4230df97", platform: "android" },
+    { id: "15b5de2e", userId: "4230df97", platform: "android" },
+    { id: "c89e8e97", userId: "4230df97", platform: "android" },
+    { id: "efa57473", userId: "4230df97", platform: "android" },
+    { id: "30ab745a", userId: "f63d56e3", platform: "windows" },
+    { id: "2990e4ca", userId: "4230df97", platform: "android" },
+    { id: "2fc7af85", userId: "d5ffd512", platform: "android" },
+    { id: "5d6e9d5e", userId: "f3519b0a", platform: "ios" },
+  ];
+  const s = summarizeMachines(devices);
+  assert.equal(s.records, 10, "vẫn đủ 10 bản ghi, không mất dữ liệu");
+  assert.equal(s.machines, 6, "minhnb2@me.com: 1 macos + 1 nhóm android; 3 tài khoản kia mỗi người 1-2 máy");
+  assert.equal(s.legacy_android_records, 6, "6 bản ghi android (5 của minhnb2@me.com + 1 của haitinhvuong)");
+  assert.equal(s.legacy_android_grouped_away, 4, "6 bản ghi android trải 2 tài khoản ⇒ gộp bớt 4");
+});
+
+test("bản ghi Android ĐÃ có mã máy không bị gộp với nhóm legacy", () => {
+  const devices = [
+    { id: "old", userId: "u1", platform: "android" },
+    { id: "new", userId: "u1", platform: "android", machineId: "ANDROID-ABC" },
+  ];
+  const s = summarizeMachines(devices);
+  assert.equal(s.machines, 2, "1 máy đã nhận diện + 1 nhóm bản ghi cũ");
+});
