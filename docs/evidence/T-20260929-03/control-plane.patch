diff --git a/control-plane/src/index.js b/control-plane/src/index.js
index bdb34c5..82525ad 100644
--- a/control-plane/src/index.js
+++ b/control-plane/src/index.js
@@ -2798,7 +2798,36 @@ app.get(["/v1/admin/ios/apple", "/admin/ios/apple"], requireAdminAuth, async (_r
     const status = await appleAsc.status();
