map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 127.0.0.1:3081;
    server_name _;

    location = /login {
        proxy_pass http://127.0.0.1:9090;
    }
    location = /logout {
        proxy_pass http://127.0.0.1:9090;
    }
    location = /check {
        proxy_pass http://127.0.0.1:9090;
    }
    location @login_redirect {
        return 302 https://$host/login;
    }
    # Never cache icons/manifest — browsers cache favicons hard by default.
    location = /favicon.png { proxy_pass http://127.0.0.1:3080; add_header Cache-Control "no-cache, no-store, must-revalidate"; }
    location = /favicon.svg { proxy_pass http://127.0.0.1:3080; add_header Cache-Control "no-cache, no-store, must-revalidate"; }
    location = /manifest.webmanifest { proxy_pass http://127.0.0.1:3080; add_header Cache-Control "no-cache, no-store, must-revalidate"; }
    # Root document: never cache (__DSH_BOOT__ plugin graph changes on restart).
    location = / {
        auth_request /check;
        error_page 401 = @login_redirect;
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    # Content-addressed assets (hashed filenames) — safe to cache forever.
    location /assets/ {
        auth_request /check;
        error_page 401 = @login_redirect;
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header Origin "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    # Plugin bundles (URLs versioned by ?rev=) — cache forever per URL.
    location /plugins/@deepseek-ai/ {
        auth_request /check;
        error_page 401 = @login_redirect;
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header Origin "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location / {
        auth_request /check;
        error_page 401 = @login_redirect;
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header Origin "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
