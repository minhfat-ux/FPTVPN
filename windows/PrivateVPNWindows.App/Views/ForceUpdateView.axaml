<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VpnFlow.App.Views.ForceUpdateView">
  <!-- Bố cục bám ForceUpdateViewMac.swift: icon tải xuống, tên VPNFlow, tiêu đề,
       mô tả và nút Update. -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="20" VerticalAlignment="Center">
      <Path Data="{StaticResource VpnUpdateGeometry}"
            Fill="{DynamicResource VpnAccentBrush}"
            Width="64"
            Height="64"
            Stretch="Uniform"
            HorizontalAlignment="Center" />

      <TextBlock Classes="vpnBrand" HorizontalAlignment="Center">
        <Run Text="VPN" Foreground="#FFFFFF" /><Run Text="Flow" Foreground="#33C773" />
      </TextBlock>

      <TextBlock Text="Update Required"
                 Classes="vpnTitle"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" />

      <TextBlock Text="A new version of VPNFlow is required to continue. Please download the latest version at meetflowai.site/buy."
                 Classes="vpnSubtitle"
                 TextWrapping="Wrap"
                 TextAlignment="Center" />

      <Button Name="UpdateButton"
              Classes="vpnPrimary"
              Content="Update"
              MaxWidth="320"
              HorizontalAlignment="Center" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
