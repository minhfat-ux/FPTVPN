<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VpnFlow.App.Views.MainView">
  <!-- Bố cục bám ContentViewMac.swift / ContentView.swift: header (logo + trạng thái +
       tên VPNFlow), thẻ chọn server, nút nguồn tròn, thẻ chẩn đoán.
       Danh sách server do code-behind nạp từ GET /v1/nodes (không hardcode preset). -->
  <ScrollViewer>
    <StackPanel Margin="16,8,16,20" Spacing="14">

      <!-- Cảnh báo xung đột mạng (Clash Verge/Mihomo TUN, proxy hệ thống…).
           Ẩn mặc định; code-behind bật lên khi NetworkConflictDetector phát hiện vấn đề. -->
      <Border Name="ConflictBanner"
              IsVisible="False"
              Background="#3A2A0A"
              BorderBrush="#E0A030"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12,10">
        <StackPanel Spacing="6">
          <TextBlock Name="ConflictTitle"
                     FontWeight="Bold"
                     FontSize="13"
                     Foreground="#FFD37A"
                     TextWrapping="Wrap" />
          <TextBlock Name="ConflictDetail"
                     FontSize="12"
                     Foreground="#F2E4C8"
                     TextWrapping="Wrap" />
          <TextBlock Name="ConflictAdvice"
                     FontSize="12"
                     Foreground="#CFE9FF"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Header -->
      <StackPanel Spacing="5" HorizontalAlignment="Center">
        <Image Source="avares://PrivateVPNWindows.App/Assets/applogo.png"
               Width="62"
               Height="62"
               Stretch="Uniform"
               HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
          <Ellipse Name="StatusDot"
                   Width="8"
                   Height="8"
                   Fill="{DynamicResource VpnDangerBrush}"
                   VerticalAlignment="Center" />
          <TextBlock Name="StatusText"
                     Classes="vpnStatus"
                     Foreground="{DynamicResource VpnDangerBrush}"
                     Text="Disconnected" />
        </StackPanel>

        <TextBlock Name="StatusSubtitle"
                   Classes="vpnCaption"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />

        <!-- Tên thương hiệu: "VPN" trắng + "Flow" xanh brand (giống iOS/mac). -->
        <TextBlock Classes="vpnBrand" HorizontalAlignment="Center">
          <Run Text="VPN" Foreground="#FFFFFF" /><Run Text="Flow" Foreground="#33C773" />
        </TextBlock>

        <TextBlock Text="Private, encrypted internet from Vietnam"
                   Classes="vpnSubtitle"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
      </StackPanel>

      <!-- Banner lỗi: chỉ hiện khi có lỗi thật từ tầng tunnel/coordinator. -->
      <Border Name="ErrorBanner"
              IsVisible="False"
              Background="#26FF4D4D"
              BorderBrush="#59FF4D4D"
              BorderThickness="1"
              CornerRadius="11"
              Padding="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="⚠" FontSize="15" Foreground="#FF4D4D" VerticalAlignment="Top" />
          <TextBlock Name="ErrorText"
                     Classes="vpnCaption"
                     Foreground="{DynamicResource VpnTextPrimaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Chọn exit node -->
      <Border Classes="vpnCard">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0"
                  Data="{StaticResource VpnPinGeometry}"
                  Fill="{DynamicResource VpnAccentBrush}"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Server"
                       Classes="vpnSectionTitle"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Name="RefreshNodesButton"
                    Classes="vpnIcon"
                    Click="OnRefreshNodesClick"
                    ToolTip.Tip="Refresh servers">
              <Path Data="{StaticResource VpnRefreshGeometry}"
                    Fill="{DynamicResource VpnTextSecondaryBrush}"
                    Width="16"
                    Height="16"
                    Stretch="Uniform" />
            </Button>
          </Grid>

          <ListBox Name="ExitNodeList"
                   Classes="vpnServerList"
                   SelectionMode="Single"
                   MaxHeight="180"
                   SelectionChanged="OnExitNodeSelectionChanged" />

          <TextBlock Name="NoServerText"
                     Classes="vpnCaption"
                     IsVisible="False"
                     Text="No server available" />

          <TextBlock Name="OfflineHintText"
                     Classes="vpnCaption"
                     IsVisible="False"
                     Foreground="{DynamicResource VpnWarningBrush}"
                     Text="Offline mode — using saved servers" />
        </StackPanel>
      </Border>

      <!-- Nút Connect/Disconnect một chạm -->
      <Button Name="ConnectButton"
              Classes="vpnPower"
              Click="OnConnectClick">
        <Panel>
          <Path Name="ConnectGlyph"
                Data="{StaticResource VpnPowerGeometry}"
                Stroke="#FFFFFF"
                StrokeThickness="1.7"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Width="42"
                Height="42"
                Stretch="Uniform" />
          <TextBlock Name="ConnectBusyText"
                     IsVisible="False"
                     Text="…"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="#FFFFFF"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Panel>
      </Button>

      <!-- Diagnostics -->
      <Border Classes="vpnCard">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource VpnPulseGeometry}"
                  Stroke="{DynamicResource VpnAccentBrush}"
                  StrokeThickness="1.6"
                  StrokeLineCap="Round"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock Text="Diagnostics" Classes="vpnSectionTitle" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource VpnCardStrokeBrush}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="State" Classes="vpnCaption" />
            <TextBlock Grid.Column="1"
                       Name="DiagStateText"
                       Text="Disconnected"
                       Classes="vpnCaption"
                       Foreground="{DynamicResource VpnDangerBrush}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Location" Classes="vpnCaption" />
            <TextBlock Grid.Column="1"
                       Name="DiagLocationText"
                       Text="—"
                       Classes="vpnCaption"
                       Foreground="{DynamicResource VpnTextSecondaryBrush}" />
          </Grid>
          <Grid Name="DiagMessageRow" ColumnDefinitions="*,Auto" IsVisible="False">
            <TextBlock Text="Message" Classes="vpnCaption" />
            <TextBlock Grid.Column="1"
                       Name="DiagMessageText"
                       Classes="vpnCaption"
                       MaxWidth="200"
                       TextWrapping="Wrap"
                       TextAlignment="Right"
                       Foreground="{DynamicResource VpnTextSecondaryBrush}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
