<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VpnFlow.App.Views.SettingsView">
  <!-- Bố cục bám SettingsViewMac.swift: các nhóm Language / Account / Subscription /
       Support trên nền navy, thẻ card giống iOS. -->
  <ScrollViewer>
    <StackPanel Margin="16,14,16,20" Spacing="12">
      <TextBlock Text="Settings" Classes="vpnTitle" HorizontalAlignment="Center" />

      <Border Classes="vpnCard">
        <StackPanel Spacing="10">
          <TextBlock Text="Language" Classes="vpnSectionTitle" />
          <ComboBox Name="LanguageCombo" Classes="vpnField" SelectedIndex="0">
            <ComboBoxItem>System Setting</ComboBoxItem>
            <ComboBoxItem>English</ComboBoxItem>
            <ComboBoxItem>Vietnamese</ComboBoxItem>
            <ComboBoxItem>Chinese</ComboBoxItem>
            <ComboBoxItem>Japanese</ComboBoxItem>
            <ComboBoxItem>Korean</ComboBoxItem>
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Classes="vpnCard">
        <StackPanel Spacing="10">
          <TextBlock Text="Connection" Classes="vpnSectionTitle" />
          <TextBlock Text="Transport" Classes="vpnFieldLabel" />
          <!-- Thứ tự item PHẢI khớp thứ tự khai báo TransportPreference: code-behind đọc/ghi
               theo index (SettingsView.axaml.cs). -->
          <ComboBox Name="TransportCombo" Classes="vpnField">
            <ComboBoxItem>Auto</ComboBoxItem>
            <ComboBoxItem>WireGuard UDP</ComboBoxItem>
            <ComboBoxItem>WebSocket Relay</ComboBoxItem>
            <ComboBoxItem>Hysteria2 (chưa hỗ trợ)</ComboBoxItem>
            <ComboBoxItem>Hysteria2 + sing-box (relay)</ComboBoxItem>
          </ComboBox>
          <TextBlock Name="TransportHintText" Classes="vpnSubtitle" TextWrapping="Wrap"
                     Text="Auto thử đường Hysteria2-over-WebSocket (relay) trước, không lên thì tự rơi về WireGuard." />
        </StackPanel>
      </Border>

      <Border Classes="vpnCard">
        <StackPanel Spacing="10">
          <TextBlock Text="Account" Classes="vpnSectionTitle" />
          <TextBlock Name="AccountText" Text="Not signed in." Classes="vpnSubtitle" TextWrapping="Wrap" />
          <Button Name="SignOutButton" Classes="vpnNav" Content="Sign Out" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="vpnCard">
        <StackPanel Spacing="10">
          <TextBlock Text="Subscription" Classes="vpnSectionTitle" />
          <TextBlock Text="Premium Required" Classes="vpnSubtitle" />
          <Button Name="UpgradeButton" Classes="vpnPrimary" Content="Upgrade" />
        </StackPanel>
      </Border>

      <Border Classes="vpnCard">
        <StackPanel Spacing="6">
          <TextBlock Text="Support" Classes="vpnSectionTitle" Margin="0,0,0,4" />
          <Button Name="ContactSupportButton" Classes="vpnNav" Content="Contact Support" HorizontalAlignment="Left" />
          <Button Name="PrivacyButton" Classes="vpnNav" Content="Privacy Policy" HorizontalAlignment="Left" />
          <Button Name="TermsButton" Classes="vpnNav" Content="Terms of Use" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="vpnCard">
        <StackPanel Spacing="6">
          <TextBlock Text="About" Classes="vpnSectionTitle" Margin="0,0,0,4" />
          <!-- Số hiệu lấy từ metadata của chính file .exe (không tin tên bộ cài) + số mốc trên
               server, để nhìn là biết bản đã publish có đúng không (21/09/2026: installer tên
               1.4.1 nhưng app khai 1.0.0, không nhìn ra được). -->
          <TextBlock Name="VersionText" Classes="vpnSubtitle" Text="Version" />
          <TextBlock Name="ServerVersionText" Classes="vpnSubtitle" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
