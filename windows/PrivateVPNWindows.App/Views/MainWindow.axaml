<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VpnFlow.App.Views.MainWindow"
        Title="VPNFlow"
        Width="350"
        Height="600"
        MinWidth="300"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource VpnBackgroundBrush}"
        RequestedThemeVariant="Dark">
  <!-- Không còn thanh nav dev ("Main / Sign in / Settings / Update"): điều hướng theo
       đúng luồng bản macOS — chưa đăng nhập thì mở màn đăng nhập, bánh răng mở Settings. -->
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0"
                Name="BackButton"
                Classes="vpnNav"
                Content="Done"
                IsVisible="False"
                Click="OnBackClick" />
        <Button Grid.Column="2"
                Name="SettingsButton"
                Classes="vpnIcon"
                Click="OnSettingsClick"
                ToolTip.Tip="Settings">
          <TextBlock Text="⚙" FontSize="15" Foreground="{DynamicResource VpnTextSecondaryBrush}" />
        </Button>
      </Grid>
    </Border>

    <ContentControl Name="HostContent" />
  </DockPanel>
</Window>
