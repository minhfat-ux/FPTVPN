<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VpnFlow.App.Views.LoginView">
  <!-- Bố cục bám LoginViewMac.swift: logo + tên VPNFlow, thẻ chứa ô email / mã,
       nút gửi & xác minh. -->
  <ScrollViewer>
    <StackPanel Margin="16,24,16,20" Spacing="16">

      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <Image Source="avares://PrivateVPNWindows.App/Assets/applogo.png"
               Width="62"
               Height="62"
               Stretch="Uniform"
               HorizontalAlignment="Center" />
        <TextBlock Classes="vpnBrand" HorizontalAlignment="Center">
          <Run Text="VPN" Foreground="#FFFFFF" /><Run Text="Flow" Foreground="#33C773" />
        </TextBlock>
        <TextBlock Text="Private, encrypted internet from Vietnam"
                   Classes="vpnSubtitle"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
      </StackPanel>

      <Border Classes="vpnCard" CornerRadius="14" Padding="14">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Text="Email" Classes="vpnFieldLabel" />
            <TextBox Name="EmailBox" Classes="vpnField" Watermark="you@example.com" />
          </StackPanel>

          <Button Name="SendCodeButton" Classes="vpnPrimary" Content="Send Code" />

          <Border Height="1" Background="{DynamicResource VpnCardStrokeBrush}" />

          <StackPanel Spacing="6">
            <TextBlock Text="Login code" Classes="vpnFieldLabel" />
            <TextBox Name="CodeBox" Classes="vpnField" Watermark="123456" />
          </StackPanel>

          <Button Name="VerifyCodeButton" Classes="vpnPrimary" Content="Verify Code" />
        </StackPanel>
      </Border>

      <!-- Phản hồi thật từ coordinator: mã dev / đã gửi mã / lỗi xác minh. -->
      <TextBlock Name="MessageText"
                 Classes="vpnCaption"
                 IsVisible="False"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
