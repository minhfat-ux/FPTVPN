<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VpnFlow.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Chỉ nhúng manifest (yêu cầu quyền admin) khi build/publish cho Windows. -->
    <ApplicationManifest Condition="$(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrivateVPNWindows.Core\PrivateVPNWindows.Core.csproj" />
  </ItemGroup>

  <!-- Binary tunnel userspace (xem windows/assets/THIRD_PARTY.md): copy ra cạnh exe để
       WintunWireGuardDriver tự lo tunnel. Điều kiện Exists để build trên macOS vẫn chạy
       được khi asset chưa tải (fetch-assets.sh). -->
  <ItemGroup>
    <None Include="..\assets\wintun.dll" Link="wintun.dll"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\wintun.dll')" />
    <None Include="..\assets\wireguard-go.exe" Link="wireguard-go.exe"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\wireguard-go.exe')" />
  </ItemGroup>

</Project>
