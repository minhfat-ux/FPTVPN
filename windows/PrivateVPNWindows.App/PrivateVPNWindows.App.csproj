<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VpnFlow.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Số hiệu PHẢI nằm trong metadata file .exe, không chỉ ở tên bộ cài: trước 22/09/2026
         build.ps1 giải version SAU bước publish nên app tự khai 1.0.0 dù installer tên 1.4.1 —
         không cách nào biết bản đã cài là bản nào (cổng scripts/check-publish-version.py bắt được).
         build.ps1 đọc <Version> ở đây và truyền /p:Version cho dotnet publish; Settings → About
         hiện đúng số này. -->
    <Version>1.4.4</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Chỉ nhúng manifest (yêu cầu quyền admin) khi build/publish cho Windows. -->
    <ApplicationManifest Condition="$(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <!-- Icon app đúng thương hiệu VPNFlow (16/32/48/64/128/256), lấy từ bộ icon
         chính thức của bản iOS (iOS/PrivateVPN/Assets.xcassets/AppIcon.appiconset).
         Hiện trên exe, shortcut và cả bộ cài Inno Setup. -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrivateVPNWindows.Core\PrivateVPNWindows.Core.csproj" />
  </ItemGroup>

  <!-- Logo thương hiệu dùng trong UI — cùng ảnh với iOS/AppLogo.imageset
       (app-logo-76@3x.png) và logo bản mac, nhúng vào assembly để hiển thị
       đúng tỉ lệ, không crop/méo. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\applogo.png" />
  </ItemGroup>

  <!-- Binary tunnel userspace (xem windows/assets/THIRD_PARTY.md): copy ra cạnh exe để
       WintunWireGuardDriver tự lo tunnel. Điều kiện Exists để build trên macOS vẫn chạy
       được khi asset chưa tải (fetch-assets.sh). -->
  <ItemGroup>
    <None Include="..\assets\wintun.dll" Link="wintun.dll"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\wintun.dll')" />
    <None Include="..\assets\wireguard-go.exe" Link="wireguard-go.exe"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\wireguard-go.exe')" />
    <!-- Đường "hysteria2 bọc trong WebSocket": flowvpnrelay.exe (SOCKS5 nội bộ) + sing-box.exe
         (TUN/định tuyến). HysteriaRelayTunnel tìm chúng cạnh app (AppContext.BaseDirectory). -->
    <None Include="..\assets\sing-box.exe" Link="sing-box.exe"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\sing-box.exe')" />
    <None Include="..\assets\flowvpnrelay.exe" Link="flowvpnrelay.exe"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\flowvpnrelay.exe')" />
  </ItemGroup>

</Project>
