# flowdesk — production environment (install at /etc/flowdesk/flowdesk.env, chmod 600).
# NEVER commit the real file. Copy from this example and fill every CHANGE_ME.

# Secret ký token phiên + HMAC mã kích hoạt. Bắt buộc, >= 32 ký tự.
# Generate: openssl rand -base64 48
DESK_SECRET=CHANGE_ME_openssl_rand_base64_48

# Token admin cho các route cấp/thu hồi mã. Bắt buộc, >= 16 ký tự.
# Bên fBuddy phải cấu hình ĐÚNG token này ở FBUDDY_DESK_ADMIN_TOKEN.
DESK_ADMIN_TOKEN=CHANGE_ME_long_random_admin_token

# Bind: Caddy kết thúc TLS rồi proxy vào cổng loopback này (khác 7790 của fBuddy).
DESK_HOST=127.0.0.1
DESK_PORT=7791

# DB riêng của flowdesk (service này ghi vào đây).
DESK_DATA_DIR=/var/lib/flowdesk

# DB của fBuddy — CHỈ ĐỌC, nguồn sự thật duy nhất cho quyền sử dụng.
DESK_FBUDDY_DB=/var/lib/fbuddy/fbuddy.db

DESK_PUBLIC_URL=https://desk.meetflowai.site
DESK_TRUST_PROXY=true

# Mã kích hoạt: sống bao lâu, dùng được cho mấy thiết bị.
DESK_CODE_TTL_DAYS=30
DESK_MAX_DEVICES_PER_CODE=3

# Token phiên ngắn hạn (phút) — app tự gia hạn qua /v1/desktop/session.
DESK_SESSION_TTL_MIN=45

# Hạn mức audio mỗi tháng cho mỗi user (phút). 0 = không giới hạn.
DESK_MAX_STT_MINUTES_PER_MONTH=600

# Rate limit theo IP.
DESK_RATE_ACTIVATE_PER_HOUR=20
DESK_RATE_ACTIVATE_FAIL_PER_10MIN=8
DESK_RATE_SESSION_PER_HOUR=240
DESK_RATE_ADMIN_PER_HOUR=120

# Key nhà cung cấp của RIÊNG bản Windows (KHÔNG dùng chung với web fBuddy hay
# backend Mac api.meetflowai.site — xoay key bên này không làm chết bên kia).
DESK_SONIOX_API_KEY=CHANGE_ME_soniox_key_rieng_cho_windows
DESK_SONIOX_MODEL=stt-rt-v5
DESK_OPENROUTER_API_KEY=CHANGE_ME_openrouter_key_rieng_cho_windows
DESK_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
