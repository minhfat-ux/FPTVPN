# fBuddy — production environment (install at /etc/fbuddy/fbuddy.env, chmod 600).
# NEVER commit the real file. Every value here is required unless marked optional.

# Secret used for JWT signing + AES-256-GCM encryption of provider/MCP credentials.
# Generate with:  openssl rand -base64 48
FBUDDY_SECRET=CHANGE_ME_openssl_rand_base64_48

# Public origin (used for CORS + Secure cookies).
FBUDDY_PUBLIC_URL=https://fbuddy.meetflowai.site

# Bind: Caddy terminates TLS and proxies to this loopback port.
FBUDDY_HOST=127.0.0.1
FBUDDY_PORT=7790

# SQLite database, uploaded files and generated artifacts.
FBUDDY_DATA_DIR=/var/lib/fbuddy

FBUDDY_APP_NAME=fBuddy
FBUDDY_TRUST_PROXY=true

# Optional: extra dev origins for CORS (comma separated). Leave empty in production.
FBUDDY_DEV_ORIGINS=
