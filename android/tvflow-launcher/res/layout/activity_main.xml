<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <!-- Logo FPT làm hình nền (watermark) -->
    <ImageView
        android:layout_width="560dp"
        android:layout_height="344dp"
        android:layout_gravity="center"
        android:layout_marginTop="26dp"
        android:src="@drawable/fpt_logo"
        android:scaleType="fitCenter"
        android:alpha="0.09"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:paddingTop="34dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="50sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <TextView
                android:id="@+id/hintSort"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingBottom="3dp"
                android:gravity="end"
                android:text="@string/hint_sort"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:alpha="0.7"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <TextView
            android:id="@+id/appsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/row_apps"
            android:textColor="@color/mint"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.16" />

        <HorizontalScrollView
            android:id="@+id/scrollApps"
            android:layout_width="match_parent"
            android:layout_height="138dp"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:focusable="false"
            android:descendantFocusability="afterDescendants">

            <LinearLayout
                android:id="@+id/rowApps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/shortcutsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/row_shortcuts"
            android:textColor="@color/mint"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.16" />

        <HorizontalScrollView
            android:id="@+id/scrollShortcuts"
            android:layout_width="match_parent"
            android:layout_height="138dp"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:focusable="false"
            android:descendantFocusability="afterDescendants">

            <LinearLayout
                android:id="@+id/rowShortcuts"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
