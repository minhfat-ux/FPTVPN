<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MẪU tham chiếu — bản sao của plist THẬT trên máy này (do `bash scripts/harness-patches-install.sh`
     sinh ra và nạp lại). plist phải trỏ vào bản cài trên Ổ TRONG (~/.local/share/harness-patches)
     vì launchd bị TCC chặn đọc ổ ngoài chứa repo (BIWIN).
     Việc: `npm i -g @deepseek-ai/dsh` xoá patch (theme #33C773, logo FlowTech, tên HarnessFlow,
     icon Culi) -> agent vá NGAY khi DSH đổi (WatchPaths) + nhịp dự phòng mỗi 900 s, nhắn Telegram.
     Không tự restart `dsh web`.
     Sửa file này KHÔNG đổi plist thật: nguồn sinh plist là harness-patches-install.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>site.meetflowai.harness-patches</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/minhnguyen/.local/share/harness-patches/harness-ensure-patches.sh</string>
    <string>--quiet</string>
    <string>--notify</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>/opt/homebrew/lib/node_modules/@deepseek-ai/dsh/package.json</string>
    <string>/opt/homebrew/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-web-frontend/dist</string>
    <string>/opt/homebrew/lib/node_modules/@deepseek-ai</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/harness-patches.log</string>
  <key>StandardErrorPath</key><string>/tmp/harness-patches.log</string>
</dict>
</plist>
