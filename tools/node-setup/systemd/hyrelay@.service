[Unit]
Description=VPNFlow TCP<->UDP relay (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %i = TCP listen port; target port is provided by the Environment line added
# by provision-node.sh (e.g. HYRELAY_TARGET=127.0.0.1:8443).
Environment=HYRELAY_TARGET=127.0.0.1:8443
ExecStart=/usr/local/bin/hyrelay -listen :%i -target ${HYRELAY_TARGET}
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
