# Xcode
*.xcodeproj/
xcuserdata/
DerivedData/
build/
*.xcuserstate

# Secrets / credentials — never commit
.tmp/
*.pem
*.p12
*.key
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
.env
.env.*
*.xcconfig
secrets/
*.secret

# Apple / Xcode user state
*.orig

# macOS
.DS_Store
._*
.AppleDouble

# SwiftPM
.build/
.swiftpm/

# WireGuardKit vendored build artifacts (libwg-go.a built at link time)
Vendor/WireGuardKit/Sources/WireGuardKitGo/out/
Vendor/WireGuardKit/Sources/WireGuardKitGo/.tmp/
Vendor/WireGuardKit/Sources/WireGuardKitGo/goroot/

# PrivateVPN runtime artifacts
.privatevpn/tmp/
*.log.local

# Scratch task notes (not part of the project)
tasks/
.dhs-setup/

# Local build artifacts
.derivedData-*/
.dd-ios-ipad/
.dd-mac/
# Mọi derived-data dựng tay/.dd-mac-rel/, .dd-mac-rel2/, .dd-mac-run/… — sinh lại được, và
# vài GB mỗi thư mục nên đừng để lọt vào commit.
.dd-*/
FPT-Harness/

# Local toolchains (JDK on BIWIN — ExFAT, keep out of git)
.tools/

# Built release artifacts (APKs / archives) — regenerate with gradle/xcodebuild
release/
android/app/libs/hysteria-sources.jar

# Windows client (C#/.NET + Avalonia) — không commit build output
windows/**/bin/
windows/**/obj/
windows/dist/
# Bộ cài Inno Setup: bản publish (~100 MB) + file .exe phát cho khách — dựng lại được
# bằng `windows/installer/build.ps1`, nên đừng để lọt vào commit.
windows/installer/out/
windows/installer/publish/

# harness-shot.mjs: browser profile + screenshot output
.shots/

# DSH harness: session state + checkpoint/spill files của máy cục bộ, không thuộc dự án
.dsh/

# App Windows "MeetFlow AI": repo git RIÊNG (github.com/minhfat-ux/MeetFlowAI_Win) nằm lồng
# trong thư mục này. Để nguyên trong .gitignore: nếu commit như thư mục con, git sẽ ghi nó
# thành gitlink (submodule) trỏ tới commit không có trên remote nào của repo này.
# Muốn đổi app thì commit + push trong chính repo MeetFlowAI_Win.
MeetFlowAI_Win/
