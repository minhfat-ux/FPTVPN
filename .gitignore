node_modules/
dist/
build/
data/
# Dữ liệu TRA CỨU nằm trong source (không phải dữ liệu chạy): bảng mã biển số theo Công báo.
# `data/` bị bỏ qua vì thư mục dữ liệu chạy của server cũng tên vậy — phải mở ngoại lệ ở đây.
!server/src/data/
!server/src/data/*.json
*.log
.env
.env.*
!.env.example
.DS_Store
*.db
*.db-journal
*.db-wal
tmp/
uploads/
coverage/

# Cache npm cục bộ (ổ BIWIN không ghi được vào ~/.npm) — không commit.
.npm-cache/
ops/.rewrite-baseline.json
ops/tasks/.watch-*.json
# pidfile/trạng thái của watcher & bộ nghe là chuyện CỦA TỪNG MÁY — không được commit.
# Đã gặp thật: pidfile bị đẩy lên git, `git restore` ghi đè pid của máy khác, và nếu pid đó
# tình cờ trùng một tiến trình đang sống thì watcher tưởng "đã có watcher khác" rồi tự thoát.
ops/tasks/.*
AGENTS.local.md
